<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_historial.xml
    Pantalla de historial del vecino. Muestra:
    - Gráfico de barras con horas ganadas/gastadas por mes (MPAndroidChart)
    - Lista de transacciones completadas (con título del servicio)
    - Lista de transacciones canceladas
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.historial.HistorialFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_historial"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <!-- Gráfico de barras -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Subtítulo: transacciones completadas -->
        <TextView
            android:id="@+id/tvSubtituloCompletadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/label_completadas"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Lista de transacciones completadas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_transaccion" />

        <!-- Mensaje cuando no hay completadas -->
        <TextView
            android:id="@+id/tvVacioHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/historial_vacio"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- Subtítulo: transacciones canceladas -->
        <TextView
            android:id="@+id/tvSubtituloCanceladas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/label_canceladas"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Lista de transacciones canceladas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCanceladas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            tools:listitem="@layout/item_transaccion" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
