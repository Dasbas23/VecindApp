<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_historial.xml
    Pantalla de historial del vecino. Muestra:
    - Gráfico de barras con horas ganadas/gastadas por mes (MPAndroidChart)
    - TabLayout para alternar entre completadas y canceladas
    - Lista de transacciones (un solo RecyclerView)
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.historial.HistorialFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_historial"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <!-- Subtítulo descriptivo -->
        <TextView
            android:id="@+id/tvSubtituloHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitulo_historial"
            android:textSize="13sp"
            android:textColor="@color/texto_secundario"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <!-- Gráfico de barras -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Pestañas: Completadas / Canceladas -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:tabMode="fixed"
            app:tabGravity="fill">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_completadas" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_canceladas" />

        </com.google.android.material.tabs.TabLayout>

        <!-- Lista de transacciones (única, alternada por pestaña) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_transaccion" />

        <!-- Mensaje cuando no hay datos en la pestaña activa -->
        <TextView
            android:id="@+id/tvVacioHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/historial_vacio"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
