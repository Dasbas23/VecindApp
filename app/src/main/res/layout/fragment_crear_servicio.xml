<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_crear_servicio.xml
    Formulario para publicar un nuevo servicio en el escaparate.
    Campos: título, descripción, categoría (Spinner), coste en horas.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Título del formulario -->
        <TextView
            android:id="@+id/tvTituloFormulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/titulo_crear_servicio"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Campo: Título del servicio -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_titulo"
            app:layout_constraintTop_toBottomOf="@id/tvTituloFormulario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo: Descripción -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_descripcion"
            app:layout_constraintTop_toBottomOf="@id/tilTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:gravity="top"
                android:maxLength="300" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Label: Categoría -->
        <TextView
            android:id="@+id/tvLabelCategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_categoria"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tilDescripcion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Spinner: Categoría del servicio -->
        <Spinner
            android:id="@+id/spinnerCategoria"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelCategoria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Label del coste (se actualiza dinámicamente) -->
        <TextView
            android:id="@+id/tvLabelCoste"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/spinnerCategoria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Coste en horas: 1h" />

        <!-- Slider: Coste en horas (0.25–8.0, paso 0.25) -->
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderCoste"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:value="1.0"
            android:valueFrom="0.25"
            android:valueTo="8.0"
            android:stepSize="0.25"
            app:layout_constraintTop_toBottomOf="@id/tvLabelCoste"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botón: Guardar servicio -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_guardar"
            app:layout_constraintTop_toBottomOf="@id/sliderCoste"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

    <!-- Botón flotante para volver atrás (estilo iOS, top|end) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/desc_volver"
        android:src="@drawable/ic_arrow_back"
        app:backgroundTint="@color/blanco_tarjetas"
        app:fabSize="mini"
        app:tint="@color/teal_vecindapp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>